# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Comma-separated allowed origins, or * for any (development only).
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Supabase
# Project dashboard -> Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co

# anon / publishable key — safe to expose to clients
SUPABASE_ANON_KEY=

# service_role / secret key — NEVER ship this to the mobile app or commit it
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=product-images

# ---------------------------------------------------------------------------
# Direct Postgres connection — used ONLY by `npm run db:migrate`.
# The API itself never uses this; it talks to Supabase over HTTPS.
#
# Dashboard -> Connect (top bar) -> Session pooler -> copy the URI, then replace
# [YOUR-PASSWORD] with your database password.
# Use the SESSION pooler on port 5432, not the transaction pooler on 6543 —
# migrations need a real session and 6543 does not support all DDL.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Per client IP. Tills in one store usually share an IP, so keep this well above RATE_LIMIT_MAX.
RATE_LIMIT_IP_MAX=3000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Store presentation (served to the client via GET /api/v1/config)
# ---------------------------------------------------------------------------
STORE_NAME=Fresh Mart
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
