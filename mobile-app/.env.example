# Base URL of the Node backend.
# Leave unset in development and the app derives the LAN address from the Expo
# packager, so a phone on the same Wi-Fi connects with no editing.
# Set it explicitly for a device on another network, or for a deployed API.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1

# Supabase — only needed for product image uploads, which go straight from the
# device to Storage. All other data access goes through the backend API.
# The anon/publishable key is safe to ship in a client bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_BUCKET=product-images
